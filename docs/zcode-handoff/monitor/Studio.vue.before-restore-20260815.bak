          <el-descriptions-item label="鐘舵€?>{{ STATUS_LABEL[jobDetail.job.status] }}</el-descriptions-item>
          <el-descriptions-item label="鎬讳綋杩涘害">{{ jobDetail.isContinuous ? '杩炵画鐢熸垚' : `${jobDetail.overallProgress || 0}%` }}</el-descriptions-item>
          <el-descriptions-item label="浜у嚭">{{ jobDetail.completedItems ?? jobDetail.job.current }} / {{ jobDetail.totalItems ?? jobDetail.job.total }}</el-descriptions-item>
