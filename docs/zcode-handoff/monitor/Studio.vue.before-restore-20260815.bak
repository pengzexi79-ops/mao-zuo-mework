          <span class="hint">涓嶆覆鏌擄紝鍙湅鏃堕棿绾裤€傜‘璁や骇鍝佹杩涘幓浜嗐€佹椂闀垮浜嗗啀鎵归噺璺?/span>
          <span style="flex:1"></span>
          <el-input-number v-model="variant" :min="0" :max="99" size="small" style="width:110px" />
          <el-button size="small" style="margin-left:8px" :loading="dry" @click="doDryRun">棰勮绗?N 鏉?/el-button>
        </div>

        <div v-if="plan">
          <div style="display:flex;gap:16px;font-size:13px;margin-bottom:10px;flex-wrap:wrap">
            <span>鐩爣 <b>{{ plan.targetSec.toFixed(1) }}s</b></span>
            <span>瀹為檯 <b :style="{ color: inRange ? '#67c23a' : '#f56c6c' }">{{ plan.plannedSec.toFixed(1) }}s</b></span>
            <span>鐗囨 <b>{{ plan.segments.length }}</b> 涓?/span>
            <span>閽╁瓙 <b>{{ plan.hookText || '锛堟棤锛? }}</b></span>
            <span v-if="plan.hookEndSec > plan.hookStartSec" class="muted">閽╁瓙澹扮敾 {{ plan.hookStartSec.toFixed(1) }}鈥搟{ plan.hookEndSec.toFixed(1) }}s</span>
            <span class="muted">閽╁瓙闊抽 {{ plan.hookAudioPath ? '宸茬粦瀹? : '鏈缃? }}</span>
            <span class="muted">BGM {{ plan.bgmPath ? '宸查€夋嫨' : '鏈缃? }} 路 鍙ｆ挱 {{ plan.voicePath ? '宸查€夋嫨' : '鏈缃? }}</span>
            <span class="muted">闅忔満鏍囪瘑 {{ plan.seed }}</span>
          </div>
          <div v-if="plan.hookStrategy || plan.rehookText || plan.semanticSegmentCount || plan.gridFallbackCount" style="display:flex;gap:14px;font-size:12px;flex-wrap:wrap;margin-bottom:10px">
            <span v-if="plan.hookStrategy" class="muted">閽╁瓙绛栫暐 <b>{{ hookStrategyLabel(plan.hookStrategy) }}</b></span>
            <span v-if="plan.rehookText" class="muted">涓鍐嶉挬瀛?{{ plan.rehookWindowStart?.toFixed?.(1) ?? plan.rehookWindowStart }}鈥搟{ plan.rehookWindowEnd?.toFixed?.(1) ?? plan.rehookWindowEnd }}s 路 {{ plan.rehookText }}</span>
            <span v-if="plan.semanticSegmentCount" class="muted">璇箟鍊欓€?<b>{{ plan.semanticSegmentCount }}</b> 鏉?/span>
            <span v-if="plan.gridFallbackCount" class="muted" style="color:#e6a23c">缃戞牸闄嶇骇 <b>{{ plan.gridFallbackCount }}</b> 鏉?/span>
          </div>

          <div class="timeline-bar">
            <div v-for="(s, i) in plan.segments" :key="i" class="seg" :class="'seg-' + s.slot"
              :style="{ flex: s.duration }" :title="segTitle(s)">
              {{ s.duration >= 2.2 ? s.duration.toFixed(1) : '' }}
            </div>
          </div>
          <div style="margin-top:8px;display:flex;gap:14px;font-size:12px;flex-wrap:wrap">
            <span v-for="legendItem in legendItems" :key="legendItem.key">
              <i :style="{ display: 'inline-block', width: '10px', height: '10px', background: legendItem.color, borderRadius: '2px', marginRight: '4px' }"></i>
              {{ legendItem.label }} {{ countSlot(legendItem.key) }}
            </span>
          </div>

          <el-collapse style="margin-top:12px">
            <el-collapse-item :title="`鏃堕棿绾挎槑缁嗭紙${plan.segments.length} 娈碉級`" name="1">
              <el-table :data="plan.segments" size="small" max-height="300">
                <el-table-column prop="index" label="#" width="50" />
                <el-table-column label="娈典綅" width="90">
                  <template #default="{ row }">
                    <el-tag size="small" :color="slotColor(row.slot)" style="color:#fff;border:none">
                      {{ slotLabel(row.slot) }}
                    </el-tag>
                  </template>
                </el-table-column>
                <el-table-column prop="materialName" label="绱犳潗" min-width="200" show-overflow-tooltip />
                <el-table-column label="鍙栬嚜" width="100">
                  <template #default="{ row }">{{ row.sourceStart.toFixed(1) }}s 璧?/template>
                </el-table-column>
                <el-table-column label="鏃堕暱" width="80">
                  <template #default="{ row }">{{ row.duration.toFixed(2) }}s</template>
                </el-table-column>
                <el-table-column prop="kind" label="绫诲瀷" width="70" />
              </el-table>
            </el-collapse-item>
            <el-collapse-item v-if="plan.notes?.length" :title="`鎵ц鏃ュ織锛?{plan.notes.length} 鏉★級`" name="2">
              <div v-for="(n, i) in plan.notes" :key="i" class="mono muted" style="line-height:1.9">{{ n }}</div>
            </el-collapse-item>
          </el-collapse>
        </div>
        <div v-else class="muted">鐐广€岄瑙堢 N 鏉°€嶇湅鐪嬭繖娆′細鍓垚浠€涔堟牱銆傛敼 N 鍙互瀵规瘮涓嶅悓鏉′箣闂寸殑宸紓鍖栥€?/div>
      </div>

      <!-- 绱犳潗缂哄彛鍒嗘瀽 -->
      <div v-if="materialGap" class="card gap-card">
        <div class="card-title">
          绱犳潗缂哄彛璇婃柇
          <span class="hint">褰撳墠绱犳潗涓嶈冻浠ユ弧瓒冲嚭鐗囪姹傛椂鐨勮嚜鍔ㄥ垎鏋?/span>
          <span style="flex:1"></span>
          <el-button size="small" :loading="gapLoading" @click="doGapAnalysis">閲嶆柊鍒嗘瀽</el-button>
        </div>
        <el-alert v-if="materialGap.sufficient" type="success" :closable="false" show-icon title="绱犳潗鍏呰冻"
          style="margin-bottom:10px" />
        <el-alert v-else type="warning" :closable="false" show-icon title="绱犳潗涓嶈冻"
          style="margin-bottom:10px">
          <template #default>
            {{ materialGap.notes?.[0] || '褰撳墠绱犳潗涓嶈冻浠ヨ鐩栫洰鏍囨椂闀裤€? }}
          </template>
        </el-alert>
        <div class="gap-grid">
          <div class="gap-item">
            <span class="gap-label">鍙敤鐢婚潰鏃堕暱</span>
            <b :style="{ color: materialGap.sufficient ? '#67c23a' : '#f56c6c' }">{{ materialGap.availableVisualSec?.toFixed(1) || '0.0' }} 绉?/b>
          </div>
          <div class="gap-item">
            <span class="gap-label">瑕佹眰鏈€鐭椂闀?/span>
            <b>{{ materialGap.requestedMinSec }} 绉?/b>
          </div>
          <div class="gap-item">
            <span class="gap-label">鍙鐢婚潰鏁?/span>
            <b>{{ materialGap.visualCount }}</b>
            <span class="muted" style="font-size:11px">锛堟€昏 {{ materialGap.totalVisualCount }} 鏉★級</span>
          </div>
          <div v-if="materialGap.projectKeyword" class="gap-item">
            <span class="gap-label">椤圭洰鍏抽敭璇?/span>
            <b>{{ materialGap.projectKeyword }}</b>
          </div>
        </div>
        <div v-if="materialGap.missingRoles?.length" class="gap-roles">
          <span class="muted">缂哄皯鐨勮鑹诧細</span>
          <el-tag v-for="role in materialGap.missingRoles" :key="role" size="small" type="warning" effect="plain" style="margin-right:6px">
            {{ ROLE_LABEL[role] || role }}
          </el-tag>
          <div v-if="materialGap.missingRoles.includes('endcard')" class="gap-endcard-hint" style="margin-top:8px">
            <el-alert type="warning" :closable="false" show-icon style="margin-bottom:8px"
              title="缂哄皯鐗囧熬鍗★紙endcard锛?
              description="鎴愮墖缁撳熬灏嗗鐢ㄤ富浣撶敾闈㈡壙杞借鍔ㄥ紩瀵硷紝杞寲瀹屾暣搴︿笉瓒炽€傚缓璁湪绱犳潗搴撴妸涓€寮犱骇鍝佸浘/鍝佺墝鍥炬爣璁颁负銆岀墖灏惧崱銆嶈鑹层€? />
            <el-button size="small" type="primary" plain @click="$router.push('/materials')">鍘荤礌鏉愬簱鏍囪 endcard</el-button>
          </div>
        </div>
        <div v-if="materialGap.roleCounts" class="gap-roles" style="margin-top:6px">
          <span v-for="(count, role) in materialGap.roleCounts" :key="role" style="margin-right:12px;font-size:12px">
            <span class="muted">{{ ROLE_LABEL[role] || role }}锛?/span><b>{{ count }}</b>
          </span>
        </div>
        <div v-if="materialGap.notes?.length > 1" class="gap-notes">
          <div v-for="(n, i) in materialGap.notes.slice(1)" :key="i" class="muted" style="font-size:12px;line-height:1.8">{{ n }}</div>
        </div>
        <div class="gap-auto" style="margin:10px 0;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <el-radio-group v-model="materialSourceMode" size="small">
            <el-radio-button label="local">浠呮湰鍦扮礌鏉?/el-radio-button>
            <el-radio-button label="builtin">鍐呯疆鍏紑琛ラ綈</el-radio-button>
            <el-radio-button label="extended">鍏紑鐩撮摼 / 瀹樻柟鎺堟潈</el-radio-button>
          </el-radio-group>
          <span class="muted" style="font-size:12px">鍏紑琛ラ綈浠呬娇鐢ㄥ彈鎺ф潵婧愶紱鍏紑鐩撮摼鍜屽畼鏂规巿鏉冪礌鏉愯鍦ㄧ礌鏉愭姄鍙栭〉瀵煎叆锛屼笉鑳界粫杩囩珯鐐规巿鏉冦€?/span>
        </div>
        <div class="gap-actions">
          <el-button type="primary" :loading="autoFillLoading" @click="doAutoFill"
            :disabled="materialSourceMode === 'local' || materialGap.sufficient">
            <span>鑷姩濉厖鍏紑绱犳潗</span>
            <span class="form-hint" style="margin-left:6px;font-size:11px">锛堝厤 Key锛屼粎璁稿彲鍙獙璇佺殑 Wikimedia / Archive锛?/span>
          </el-button>
          <el-button @click="goToCrawlWithProject">鍓嶅線绱犳潗鎶撳彇</el-button>
          <el-button @click="$router.push('/materials')">绠＄悊绱犳潗搴?/el-button>
        </div>
        <div v-if="autoFillResult" class="auto-fill-result" style="margin-top:10px">
          <el-alert :type="autoFillResult.any ? 'success' : 'warning'" :closable="false" show-icon
            :title="autoFillResult.any ? `宸叉帓闃?${autoFillResult.totalItemsQueued} 鏉＄礌鏉恅 : '鏈壘鍒板尮閰嶇殑鍏紑绱犳潗'" />
          <div v-if="autoFillResult.crawlJobIds?.length" class="muted" style="margin-top:6px;font-size:12px">
            閲囬泦浠诲姟 ID锛歿{ autoFillResult.crawlJobIds.join('銆?) }} 銆傝鍓嶅線
            <el-link type="primary" @click="goToCrawlWithProject">绱犳潗鎶撳彇</el-link> 椤甸潰鏌ョ湅杩涘害銆?
          </div>
        </div>
        <div v-if="preparationResult" class="auto-fill-result" style="margin-top:10px">
          <el-alert :type="preparationResult.ready ? 'success' : 'warning'" :closable="false" show-icon
            :title="preparationResult.ready ? '椤圭洰绱犳潗鍑嗗瀹屾垚锛屾湰娆″嚭鐗囦細浣跨敤宸插尮閰嶅拰宸插叆搴撶殑绱犳潗' : '椤圭洰绱犳潗浠嶆湁缂哄彛锛屾湰娆″皢浣跨敤宸叉垚鍔熷叆搴撶殑绱犳潗缁х画棰勬'" />
          <div v-if="preparationResult.autoFill && !preparationResult.autoFill.any" class="prepare-fallback-hint" style="margin-top:8px">
            <el-alert type="info" :closable="false" show-icon title="娌℃湁鍙敤鐨勫叕寮€绱犳潗"
              description="鍏紑鏉ユ簮鏈兘鍏ュ簱绱犳潗锛屾湰娆″嚭鐗囦細缁х画浣跨敤褰撳墠鏈湴绱犳潗锛屼笉浼氫腑鏂共璺戯紱鍙墠寰€銆岀礌鏉愭姄鍙栥€嶉〉鎵嬪姩瀵煎叆鍏紑绱犳潗鍚庡啀璇曘€? />
          </div>
          <div v-if="preparationSourceIssueRows.length" class="prepare-source-issues" style="margin-top:8px">
            <div v-for="(issue, idx) in preparationSourceIssueRows" :key="'final-' + idx" class="prepare-source-issue">
              <el-tag size="small" :type="issue.status === 'failed' ? 'danger' : 'warning'">{{ issue.status === 'failed' ? '鏉ユ簮澶辫触' : '鏉ユ簮鐔旀柇' }}</el-tag>
              <span class="prepare-source-name">{{ issue.source }}</span>
              <span class="muted">{{ issue.message }}{{ issue.retryAfterSeconds ? `锛堢害 ${issue.retryAfterSeconds} 绉掑悗鎭㈠锛塦 : '' }}</span>
            </div>
          </div>
          <div class="prepare-stage-list">
            <div v-for="(stage, idx) in preparationResult.stages || []" :key="stage.name + '-' + idx" class="prepare-stage-row">
              <el-tag size="small" :type="prepareStageType(stage.status)">{{ stage.name }}</el-tag>
              <span class="muted">{{ stage.message }}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="card batch-card">
        <div class="card-title">4. 鎵归噺鍑虹墖</div>
        <el-alert v-if="preflightMessage" :type="preflightReady ? 'success' : 'warning'" :closable="false" show-icon style="margin-bottom:12px" :title="preflightMessage" />
        <div v-if="preparing || dry || submitting || activeRenderJob" class="batch-live-panel"
          :class="activeRenderJob ? `batch-live-${activeRenderJob.status}` : 'batch-live-working'">
          <div class="batch-live-header">
            <div class="batch-live-title">
              <span class="live-dot" :class="{ paused: activeRenderJob?.status === 'paused' }"></span>
              <strong>{{ livePanelTitle }}</strong>
              <el-tag size="small" :type="livePanelTagType">{{ livePanelTag }}</el-tag>
            </div>
            <span class="batch-live-refresh">姣?3 绉掓鏌ヤ竴娆?路 {{ activeRenderJob ? liveHeartbeatText : (preparing ? '姝ｅ湪鍑嗗绱犳潗骞惰疆璇㈣繘搴︼紝璇蜂笉瑕侀噸澶嶇偣鍑? : '姝ｅ湪鎵ц锛岃涓嶈閲嶅鐐瑰嚮') }}</span>
          </div>
          <template v-if="activeRenderJob">
            <div class="batch-live-main">
              <div class="batch-live-number">
                <span class="batch-live-count">{{ liveCompletedCount }}<small>/{{ liveTotalCount }}</small></span>
                <span>宸插畬鎴愭潯鏁?/span>
              </div>
              <div class="batch-live-stage">
                <div class="batch-live-stage-line"><b>{{ liveCurrentItemText }}</b><span>{{ livePhaseText }}</span></div>
                <el-progress :percentage="liveOverallProgress" :status="activeRenderJob.status === 'running' ? undefined : 'warning'" :stroke-width="14" text-inside />
                <div class="batch-live-subline">
                  <span>鎬昏繘搴?{{ liveOverallProgress }}%</span>
                  <span>褰撳墠鏉＄洰 {{ liveItemProgress }}%</span>
                  <span v-if="liveEtaText">棰勮杩橀渶 {{ liveEtaText }}</span>
                  <span>宸茶繍琛?{{ liveElapsedText }}</span>
                </div>
                <el-progress v-if="activeRenderJob.status === 'running' && liveItemProgress > 0" :percentage="liveItemProgress" :stroke-width="7" :show-text="false" status="success" />
              </div>
            </div>
          </template>
          <div v-else class="batch-preflight-state">
            <div class="batch-preflight-spinner"></div>
            <div style="flex:1;min-width:0">
              <b>{{ preparing ? '姝ｅ湪璇嗗埆椤圭洰銆佸尮閰嶆湰鍦扮礌鏉愬苟琛ラ綈鍏紑绱犳潗' : (dry ? '姝ｅ湪妫€鏌ョ礌鏉愩€佹椂闀垮拰闊抽鍙敤鎬? : '姝ｅ湪鎻愪氦鍚庡彴鍑虹墖浠诲姟') }}</b>
              <div>{{ preparing ? '鍙細浣跨敤鍥哄畾鍏紑鏉ユ簮锛涙垚鍔熷叆搴撶殑绱犳潗浼氱珛鍒诲弬鍔犳湰娆″共璺戙€? : (dry ? '浼氬厛瀹屾垚瀹夊叏棰勬锛岄妫€缁撴潫鍚庢墠浼氱湡姝ｅ嚭鐗囷紱杩欎笉鏄崱浣忋€? : '鎻愪氦鎴愬姛鍚庝細鑷姩鏄剧ず褰撳墠鏉＄洰鍜屽疄鏃惰繘搴︺€?) }}</div>
              <template v-if="preparing">
                <div class="prepare-live-stage">
                  <span class="muted">褰撳墠闃舵</span><b>{{ preparingStageName }}</b>
                  <span v-if="preparingStageMessage" class="muted">{{ preparingStageMessage }}</span>
                </div>
                <div class="prepare-live-meta">
                  <span>宸茶繍琛?{{ formatDuration(preparingElapsedSec) }}</span>
                  <span v-if="preparingWaitedSec > 0">绛夊緟鍏紑绱犳潗 {{ preparingWaitedSec }} 绉?/span>
                  <span v-if="preparingSourceIssues.length" style="color:#d46b08">鍏紑鏉ユ簮闂 {{ preparingSourceIssues.length }} 涓?/span>
                </div>
                <div v-if="preparingSourceIssues.length" class="prepare-source-issues">
                  <div v-for="(issue, idx) in preparingSourceIssues" :key="'live-' + idx" class="prepare-source-issue">
                    <el-tag size="small" :type="issue.status === 'failed' ? 'danger' : 'warning'">{{ issue.status === 'failed' ? '鏉ユ簮澶辫触' : '鏉ユ簮鐔旀柇' }}</el-tag>
                    <span class="prepare-source-name">{{ issue.source }}</span>
                    <span class="muted">{{ issue.message }}{{ issue.retryAfterSeconds ? `锛堢害 ${issue.retryAfterSeconds} 绉掑悗鎭㈠锛塦 : '' }}</span>
                  </div>
                </div>
              </template>
            </div>
          </div>
          <div class="batch-live-tip">{{ activeRenderJob ? liveActionText : (preparing ? (preparingStageMessage || '姝ｅ湪杞绱犳潗鍑嗗杩涘害锛岃淇濇寔椤甸潰鎵撳紑銆?) : (dry ? '姝ｅ湪璇诲彇 FFmpeg/FFprobe 妫€鏌ョ粨鏋滐紝璇风瓑寰呴妫€瀹屾垚銆? : '姝ｅ湪鎶婁换鍔′氦缁欏悗鍙伴槦鍒楋紝璇蜂繚鎸佸綋鍓嶉〉闈㈡墦寮€銆?)) }}</div>
        </div>
        <div class="batch-row batch-mode-row">
          <span class="batch-label">鐢熸垚鏂瑰紡</span>
          <span class="batch-option" :class="{ active: !continuous }">鍥哄畾鏁伴噺</span>
          <el-switch v-model="continuous" class="batch-switch" />
          <span class="batch-option" :class="{ active: continuous }">鎸佺画鐢熸垚</span>
          <div v-if="!continuous" class="batch-inline-field">
            <span>鏁伴噺</span><el-input-number v-model="count" :min="1" :max="200" controls-position="right" />
          </div>
        </div>
        <div class="batch-row">
          <div class="batch-field"><span>浠诲姟鍚?/span><el-input v-model="jobName" placeholder="鐣欑┖鑷姩鍛藉悕" /></div>
          <div class="batch-field"><span>瓒呮椂(鍒?</span><el-input-number v-model="jobTimeoutMin" :min="0" :max="240" :step="5" controls-position="right" /><small>0 = 浣跨敤榛樿</small></div>
          <div class="batch-field"><span>鍍垫(鍒?</span><el-input-number v-model="jobStaleMin" :min="0" :max="120" :step="5" controls-position="right" /><small>0 = 10 鍒嗛挓淇濇姢</small></div>
        </div>
        <div class="batch-row batch-action-row">
          <template v-if="!activeContinuousJob">
            <el-button type="primary" size="large" :loading="preparing || submitting || dry" :disabled="preparing || submitting || dry" @click="submit">{{ preparing ? '璇嗗埆骞惰ˉ榻愮礌鏉愪腑' : (dry ? '骞茶窇棰勬涓? : (continuous ? '寮€濮嬫寔缁敓鎴? : `寮€濮嬪嚭 ${count} 鏉)) }}</el-button>
            <el-button v-if="preparing" size="large" plain type="warning" @click="cancelPrepare">鍙栨秷鍑嗗骞剁户缁?/el-button>
          </template>
          <template v-else>
            <span class="batch-status">{{ activeContinuousJob.status === 'paused' ? '宸叉殏鍋滐紝宸茬敓鎴愮殑鎴愮墖浼氫繚鐣? : `姝ｅ湪鐢熸垚 路 宸蹭骇鍑?${jobLive[activeContinuousJob.id]?.completedItems ?? activeContinuousJob.current ?? 0} 鏉 }}<span v-if="jobLive[activeContinuousJob.id]?.phaseLabel || jobLive[activeContinuousJob.id]?.step"> 路 {{ jobLive[activeContinuousJob.id]?.phaseLabel || jobLive[activeContinuousJob.id]?.step }}</span></span>
            <el-button v-if="activeContinuousJob.status === 'paused'" type="primary" size="large" @click="resume(activeContinuousJob)">缁х画鐢熸垚</el-button>
            <el-button v-else type="warning" size="large" @click="pause(activeContinuousJob)">鏆傚仠骞朵繚鐣?/el-button>
            <el-popconfirm title="鏀惧純鏈畬鎴愬唴瀹癸紵宸茬敓鎴愮殑鎴愮墖浼氫繚鐣欍€? @confirm="cancel(activeContinuousJob)"><template #reference><el-button type="danger" plain>鏀惧純褰撳墠浠诲姟</el-button></template></el-popconfirm>
          </template>
        </div>
        <div class="form-hint batch-help">
          鍥哄畾鏁伴噺閫傚悎鍏堝嚭 1鈥? 鏉★紝纭鐢婚潰銆佽妭濂忋€佸０闊冲拰瀛楀箷鍚庡啀澧炲姞鏁伴噺銆傛寔缁敓鎴愰€傚悎骞茶窇閫氳繃涓旂礌鏉愭睜鍏呰冻鐨勯」鐩紝姣忔潯鎴愬姛鍚庢墠缁х画锛涙殏鍋滀細淇濈暀宸插畬鎴愭垚鐗囷紝绱犳潗涓嶈冻銆佽川閲忔鏌ュけ璐ユ垨杩炵画寮傚父浼氳嚜鍔ㄥ仠姝€?
        </div>
      </div>

      <div class="card">
        <div class="card-title">
          鍑虹墖浠诲姟
          <span style="flex:1"></span>
          <el-switch v-model="autoRefresh" size="small" active-text="鑷姩鍒锋柊" />
          <el-button size="small" style="margin-left:8px" @click="loadJobs">鍒锋柊</el-button>
          <el-popconfirm v-if="selectedJobIds.length" :title="`鍒犻櫎閫変腑鐨?${selectedJobIds.length} 鏉′换鍔″強鍏宠仈鎴愮墖鏂囦欢锛熻繍琛屼腑鐨勪换鍔″繀椤诲厛鍙栨秷銆俙" @confirm="batchDeleteJobs">
            <template #reference><el-button size="small" type="danger" plain style="margin-left:8px">鎵归噺鍒犻櫎锛坽{ selectedJobIds.length }}锛?/el-button></template>
          </el-popconfirm>
          <el-popconfirm title="鍙垹闄ゅ凡瀹屾垚銆佸け璐ャ€佸凡鍙栨秷鐨勪换鍔″強鍏舵湰鍦版垚鐗囨枃浠讹紝缁х画鍚楋紵" @confirm="cleanupJobs">
            <template #reference><el-button size="small" type="danger" plain style="margin-left:8px">娓呯悊缁堟€佽褰?/el-button></template>
          </el-popconfirm>
        </div>
        <el-alert v-if="jobsError" type="error" :closable="false" show-icon style="margin-bottom:10px"
          title="浠诲姟鍒楄〃鍔犺浇澶辫触锛岃鍒锋柊閲嶈瘯" />
        <div v-else-if="!initialLoading && !jobs.length" class="muted" style="margin-bottom:10px">鏆傛棤鍑虹墖浠诲姟銆?/div>
        <el-table :data="jobs" v-loading="jobsLoading" row-key="id" size="small" max-height="330" @selection-change="onJobSelectionChange" @row-dblclick="onJobRowDblClick">
          <el-table-column type="selection" width="46" :selectable="canSelectJobForDelete" />
          <el-table-column prop="id" label="#" width="55" />
          <el-table-column prop="name" label="浠诲姟" min-width="160" show-overflow-tooltip />
          <el-table-column label="鐘舵€? width="90">
            <template #default="{ row }">
              <el-tag size="small" :type="STATUS_TYPE[row.status]">{{ STATUS_LABEL[row.status] || row.status }}</el-tag>
            </template>
          </el-table-column>
          <el-table-column label="杩涘害" width="200">
            <template #default="{ row }">
              <el-progress :percentage="row.continuous ? 0 : (jobLive[row.id]?.overallProgress ?? row.progress ?? 0)" :stroke-width="12" text-inside
                :status="row.continuous ? undefined : (row.status === 'failed' ? 'exception' : (row.status === 'done' ? 'success' : ''))" />
              <div class="muted">{{ row.continuous ? `杩炵画妯″紡 路 宸蹭骇鍑?${jobLive[row.id]?.completedItems ?? row.current ?? 0} 鏉 : `${jobLive[row.id]?.completedItems ?? row.current ?? 0} / ${jobLive[row.id]?.totalItems ?? row.total ?? row.count}` }}</div>
              <el-progress v-if="jobLive[row.id]?.currentItemProgress" :percentage="jobLive[row.id].currentItemProgress" :stroke-width="6" :show-text="false" />
              <div class="muted">{{ translateTechnicalText(jobLive[row.id]?.phaseLabel || jobLive[row.id]?.step || row.summary || '绛夊緟璋冨害') }}</div>
              <div v-if="jobLive[row.id]" class="muted">宸茬敤 {{ formatDuration(jobLive[row.id].elapsedSec) }} 路 {{ jobLive[row.id].itemsPerMinute || 0 }} 鏉?鍒?span v-if="!jobLive[row.id].isContinuous && jobLive[row.id].etaSec"> 路 棰勮 {{ formatDuration(jobLive[row.id].etaSec) }}</span></div>
            </template>
          </el-table-column>
          <el-table-column label="璇存槑" min-width="180" show-overflow-tooltip>
            <template #default="{ row }">
              <span :style="{ color: row.error ? '#f56c6c' : '' }">{{ shortTaskText(row) }}</span>
            </template>
          </el-table-column>
          <el-table-column label="鎿嶄綔" width="150" fixed="right">
            <template #default="{ row }">
              <el-button link type="primary" size="small" @click="openJob(row)">璇︽儏</el-button>
              <el-button v-if="row.continuous && (row.status === 'running' || row.status === 'pending')" link type="warning"
                size="small" @click="pause(row)">鏆傚仠</el-button>
              <el-button v-if="row.status === 'paused' || row.status === 'awaiting_decision'" link type="primary" size="small" @click="resume(row)">{{ row.status === 'awaiting_decision' ? '鎸夌幇鏈夌瓥鐣ョ户缁? : '缁х画' }}</el-button>
              <el-button v-if="row.status === 'failed' || row.status === 'awaiting_decision' || (row.status === 'done' && row.error)" link type="warning" size="small" @click="retryFailed(row)">閲嶈瘯澶辫触椤?/el-button>
              <el-button v-if="row.status === 'running' || row.status === 'pending' || row.status === 'paused' || row.status === 'awaiting_decision'" link type="danger"
                size="small" @click="cancel(row)">鍙栨秷</el-button>
              <el-popconfirm title="鍒犻櫎浠诲姟鍙婂叾鎴愮墖璁板綍锛? @confirm="delJob(row)">
                <template #reference><el-button link type="danger" size="small">鍒犻櫎</el-button></template>
              </el-popconfirm>
            </template>
          </el-table-column>
        </el-table>
      </div>
    </div>

    <el-dialog v-model="jobDlg" title="浠诲姟璇︽儏" width="720px">
      <div v-if="jobDetail">
