# Copy to the project-root .env for local use. Spring Boot, start.bat and IDE starts import it.
# Keep this file local and never commit real credentials.

# Local-only HTTP bind address. For phone access on the same Wi-Fi, explicitly set 0.0.0.0
# AND set a long APP_ACCESS_TOKEN below. Never expose this service to the public internet.
APP_BIND_ADDRESS=127.0.0.1


# Web UI port. Change it when 8760 is already in use on this PC.
PORT=8760

# Bundled MySQL port. Change it when 3306 is already in use on this PC.
MYSQL_PORT=3306
# MySQL connection. Keep real credentials out of Git.
DB_URL=jdbc:mysql://127.0.0.1:3306/ai_mix_video?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_general_ci&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&rewriteBatchedStatements=true
DB_USERNAME=mixcut
DB_PASSWORD=MixcutLocal2026Secure8473  # bundled portable MySQL default; change it in the environment center

# Optional: when set, require this shared token for /api/** and /files/**.
APP_ACCESS_TOKEN=replace-with-a-long-random-token

# Exact, comma-separated browser origins for development. Never use * with credentialed CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional third-party audio/video catalog tokens. Leave blank to disable those providers.
APP_FREESOUND_API_KEY=
APP_PIXABAY_API_KEY=
APP_PEXELS_API_KEY=

# Login-required crawling remains disabled by default. Do not add browser cookies to this project.
APP_ALLOW_LOGIN_CRAWL=false
