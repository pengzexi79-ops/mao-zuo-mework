{
  "schemaVersion": 1,
  "manifestVersion": "1.0.0",
  "description": "Mework 能力中心唯一数据源：驱动 BootstrapService 的能力清单、修复安装边界与官方入口。",
  "requirementsFile": "requirements-windows.txt",
  "approvedPip": {
    "demucs": {
      "spec": "demucs==4.1.0",
