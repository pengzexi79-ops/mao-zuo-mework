    },
    "gallery-dl": {
      "spec": "gallery-dl==1.32.9",
      "repairable": true,
      "origin": "发行包预置（prepare_portable.ps1），与打包时随包 venv 版本一致；缺失时环境中心可联网修复安装。"
    },
    "rembg": {
      "spec": "rembg==2.0.78",
      "repairable": false,
      "origin": "发行包预置（prepare_portable.ps1），与打包时随包 venv 版本一致；仅随包分发，不提供一键修复安装。"
    },
    "auto-editor": {
      "spec": "auto-editor==29.3.1",
      "repairable": false,
      "origin": "发行包预置（prepare_portable.ps1），与打包时随包 venv 版本一致；仅随包分发，不提供一键修复安装。"
    },
    "opencv-python": {
      "spec": "opencv-python==5.0.0.93",
