{
  "name": "ai-douyin-mixcut-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-text-integrity.mjs && vite build && node scripts/verify-static.mjs",
    "clean": "node -e \"const fs=require('fs'),p='../backend/src/main/resources/static';fs.existsSync(p)&&fs.rmSync(p,{recursive:true,force:true});console.log('static bundle cleaned')\"",
    "rebuild": "npm run clean && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "element-plus": "^2.8.4",
    "@element-plus/icons-vue": "^2.3.1",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "vite": "^5.4.8"
  }
}
